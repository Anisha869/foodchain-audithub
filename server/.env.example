PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase database configuration is required for normal operation.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Local-only demo mode is opt-in and never writes to Supabase.
# DATA_MODE=demo

# JWT Authentication
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Required only to create the first administrator; use a long random one-time value.
ADMIN_BOOTSTRAP_TOKEN=
